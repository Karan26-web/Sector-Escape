  "vo": {
    "title-welcome": {
      "path": "audio/vo/title-welcome.mp3",
      "who": "narrator",
      "text": "Welcome to Sector Escape. Deep in the jungle, an ancient temple is waiting.",
      "dur": 6.16,
      "bytes": 74292
    },
    "title-choose": {
      "path": "audio/vo/title-choose.mp3",
      "who": "narrator",
      "text": "Press Play to begin, or tap How to play to learn first.",
      "dur": 4.46,
      "bytes": 53917
    },
    "howto-1": {
      "path": "audio/vo/howto-1.mp3",
      "who": "narrator",
      "text": "Stone guardians stand behind a broken wall. The open part of the wall is called the arc. Walk Karan to the glowing spot. A beam will sweep out from the centre.",
      "dur": 12.32,
      "bytes": 148271
    },
    "howto-2": {
      "path": "audio/vo/howto-2.mp3",
      "who": "narrator",
      "text": "The beam covers a sector, like a slice of pizza. Its area is θ over 360 times π times r squared. Always keep π in your answer. Write 12π, not 37.7.",
      "dur": 15.15,
      "bytes": 182126
    },
    "howto-3": {
      "path": "audio/vo/howto-3.mp3",
      "who": "narrator",
      "text": "Too small, and some guardians get through. Too big, and the beam bounces back. Just right, and every guardian is destroyed. You have three shields. Each wrong shot costs one. Ready?",
      "dur": 14.54,
      "bytes": 174916
    },
    "open-lost": {
      "path": "audio/vo/open-lost.mp3",
      "who": "narrator",
      "text": "Karan has lost his way deep inside an ancient jungle island.",
      "dur": 4.655,
      "bytes": 56425
    },
    "open-guarded": {
      "path": "audio/vo/open-guarded.mp3",
      "who": "narrator",
      "text": "But the temple is guarded. Seven stone courts stand in his way.",
      "dur": 5.08,
      "bytes": 61440
    },
    "tut-move": {
      "path": "audio/vo/tut-move.mp3",
      "who": "narrator",
      "text": "Use the joystick or the WASD keys to move Karan.",
      "dur": 4.44,
      "bytes": 53603
    },
    "tut-try": {
      "path": "audio/vo/tut-try.mp3",
      "who": "narrator",
      "text": "Try it. Push the joystick forward.",
      "dur": 2.65,
      "bytes": 32287
    },
    "tut-good": {
      "path": "audio/vo/tut-good.mp3",
      "who": "narrator",
      "text": "Good.",
      "dur": 0.85,
      "bytes": 10658
    },
    "tut-gate": {
      "path": "audio/vo/tut-gate.mp3",
      "who": "narrator",
